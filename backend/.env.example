# Groq API Configuration (for LLM reasoning & STT Whisper)
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Google Gemini API Configuration (for Bilingual Spoken Responses / Audio Generation)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.0-flash
GEMINI_VOICE_NAME=Aoede

# Firebase Configuration (Optional)
FIREBASE_PROJECT_ID=paperwork-access

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
